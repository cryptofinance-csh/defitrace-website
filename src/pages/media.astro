---
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import media from '../data/media.json';
---

<Layout title="Media">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Media</Fragment>
      <Fragment slot="desc">
        DeFiTrace related press coverage and media mentions
      </Fragment>
    </Sectionhead>

    <h2 class="text-2xl font-semibold text-gray-800 mt-12 text-center">
      Media Coverage
    </h2>

    <div class="flex flex-col mx-auto max-w-4xl mt-12 gap-12">
      {media.map((item) => (
        <div class="group flex items-center justify-between gap-8">
          <div class="flex flex-col gap-2 w-full">
            <h2 class="text-xl font-bold">{item.title}</h2>
            <p class="text-gray-600">
              <span class="font-semibold">{item.Quelle}</span> - {item.Date}
            </p>
            {item.link && (
              <a
                href={item.link}
                class="text-blue-500 underline hover:text-blue-700"
                target="_blank"
                rel="noopener noreferrer"
              >
                More
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </Container>
</Layout>
